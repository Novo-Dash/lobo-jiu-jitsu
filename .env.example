# Never commit real values. Set them in Vercel → Project → Environment Variables.
# Browser (public, baked into the build)
VITE_SITE_URL=                # confirmed domain, e.g. https://lp.lobojiu-jitsu.com  [CONFIRMAR]
VITE_META_PIXEL_ID=           # [CONFIRMAR]
VITE_GA4_ID=                  # [CONFIRMAR]
# Server only (api/*)
LEAD_WEBHOOK_URL=             # GHL inbound webhook  [CONFIRMAR]
GHL_LOCATION_ID=              # sends the n8n copy of the lead (Novo Dash app) when set
META_PIXEL_ID=                # the same pixel as VITE_META_PIXEL_ID (CAPI allowlist)
META_CAPI_ACCESS_TOKEN=       # [CONFIRMAR]
META_TEST_EVENT_CODE=
